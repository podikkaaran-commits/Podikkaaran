# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
# Business WhatsApp number, digits only with country code, e.g. 91XXXXXXXXXX (leave blank until you have it)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GBP_URL=
# Your verified FSSAI licence number (packs show different numbers - confirm before publishing)
NEXT_PUBLIC_FSSAI_NUMBER=

# ---- Admin (server only) ----
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_SECRET=put-a-long-random-string-here
# Optional: new-order alerts POSTed as JSON (Slack / Zapier / Make / n8n webhook)
ADMIN_WEBHOOK_URL=
# Optional: folder for orders/settings/products JSON (use a persistent disk in production)
DATA_DIR=

# ---- Razorpay (server only, never commit real keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Analytics (leave blank to disable). If GTM is set, GA4 is loaded via GTM, not directly. ----
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional: Shadowfax Forward Logistics, with the matching SFX 360 token.
SHADOWFAX_ENV=staging
SHADOWFAX_API_TOKEN=
SHADOWFAX_PICKUP_PHONE=
